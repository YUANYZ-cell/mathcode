<Window x:Class="MathCode.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="数学 × 编程" Width="1440" Height="960" MinWidth="820" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#F5F2EC" Loaded="LoadedWindow" Closing="ClosingWindow" Closed="ClosedWindow">
 <Window.Resources>
  <Storyboard x:Key="StartupMotion" RepeatBehavior="Forever">
   <DoubleAnimation Storyboard.TargetName="StartupBall" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-40" Duration="0:0:0.6" AutoReverse="True"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
   <DoubleAnimation Storyboard.TargetName="StartupSteps" Storyboard.TargetProperty="Opacity" From="0.4" To="1" Duration="0:0:0.6" AutoReverse="True"/>
  </Storyboard>
 </Window.Resources>
 <Grid>
  <wv:WebView2 x:Name="WebView"/>
  <Border x:Name="Loading" Background="#F5F2EC">
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
    <Canvas Width="96" Height="84" HorizontalAlignment="Center" ClipToBounds="True" AutomationProperties.Name="正在准备本地资料库">
     <Path x:Name="StartupSteps" Stroke="#C7B6A0" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 65,15 L 89,15 M 46,37 L 70,37 M 27,59 L 51,59"/>
     <Ellipse x:Name="StartupBall" Canvas.Left="46" Canvas.Top="40" Width="16" Height="16" Fill="#A85F45"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse>
    </Canvas>
    <TextBlock Text="数学 × 编程" FontFamily="Microsoft YaHei UI" FontSize="25" Margin="0,17,0,12" HorizontalAlignment="Center"/>
    <TextBlock x:Name="Status" Text="正在准备本地资料库…" Foreground="#8B8072" FontSize="13" TextWrapping="Wrap" MaxWidth="580" HorizontalAlignment="Center"/>
    <Button x:Name="Retry" Content="重新检查" Click="RetryStartup" Visibility="Collapsed" Margin="0,22,0,0" Padding="20,8"/>
   </StackPanel>
  </Border>
 </Grid>
</Window>
